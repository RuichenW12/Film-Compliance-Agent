# Copy to .env and replace the placeholders. Nothing here is required for the test suite.
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
REGION=your-vertex-location
FIRESTORE_EMULATOR_HOST=localhost:8791
PUBSUB_EMULATOR_HOST=localhost:8792
GCS_BUCKET=your-gcs-bucket-name
VERTEX_MODEL_GEMINI=your-gemini-model-id
# v2 is what the code defaults to. This file said v1, so anyone who copied it
# ran on the older snapshot -- whose thresholds are unpublished -- and got a
# provisional class on every project with no clue why.
SNAPSHOT_SEED_PATH=policy/seed-snapshot-v2.yaml
INTERNAL_TOKEN=t_local_internal
FLAG_VEO_TEASER=false
FLAG_US_TRACK=false
# memory: everything is lost when the API stops. Fine for tests and a
#   throwaway run, and the default so a clean slate stays the default.
# sqlite: survives a restart, which is what a demo you set up in advance
#   needs. Reset it by deleting the file below -- restarting no longer does.
STORE_BACKEND=memory
SQLITE_PATH=var/film-compliance.db
